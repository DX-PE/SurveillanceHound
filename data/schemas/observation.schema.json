{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "address_type",
    "category",
    "channel",
    "confidence",
    "event_id",
    "firmware_version",
    "first_seen_ms",
    "hardware",
    "identifier",
    "label",
    "meal_awarded",
    "observed_at",
    "privacy_mode",
    "radio",
    "reason",
    "region",
    "rssi_avg",
    "rssi_max",
    "rssi_min",
    "rule_ids",
    "schema_version",
    "score",
    "seen_count",
    "session_id",
    "signature_pack",
    "time_quality",
    "uptime_ms"
  ],
  "properties": {
    "meal_awarded": {
      "type": "boolean"
    },
    "category": {
      "enum": [
        "FLOCK",
        "AXON",
        "GLASSES",
        "SKIMMER",
        "RAVEN",
        "AIRTAG",
        "TILE",
        "SAMSUNG_TAG",
        "GOOGLE_TAG",
        "DRONE",
        "ALPR",
        "CAMERA",
        "RING",
        "IBEACON",
        "FLIPPER",
        "PWNAGOTCHI",
        "PINEAPPLE",
        "DEAUTH",
        "EVIL_TWIN"
      ]
    },
    "hardware": {
      "const": "E32R40T"
    },
    "first_seen_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "address_type": {
      "enum": [
        "public",
        "random"
      ]
    },
    "signature_pack": {
      "type": "string",
      "pattern": "^v[0-9]+-[a-f0-9]{12}$"
    },
    "channel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 14
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "reason": {
      "type": "string"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z2-7]{20}$"
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "region": {
      "enum": [
        "US",
        "EU",
        "unknown"
      ]
    },
    "firmware_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
    },
    "radio": {
      "enum": [
        "wifi",
        "ble"
      ]
    },
    "rssi_min": {
      "type": "integer",
      "minimum": -127,
      "maximum": 20
    },
    "event_id": {
      "type": "string"
    },
    "rssi_max": {
      "type": "integer",
      "minimum": -127,
      "maximum": 20
    },
    "schema_version": {
      "const": 1
    },
    "privacy_mode": {
      "enum": [
        "private",
        "research"
      ]
    },
    "label": {
      "type": "string"
    },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]{1,63}$"
      }
    },
    "seen_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "time_quality": {
      "enum": [
        "uptime_only",
        "manual"
      ]
    },
    "rssi_avg": {
      "type": "integer",
      "minimum": -127,
      "maximum": 20
    },
    "raw_mac": {
      "type": "string",
      "pattern": "^([0-9A-F]{2}:){5}[0-9A-F]{2}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "privacy_mode": {
            "const": "private"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "raw_mac"
          ]
        }
      }
    }
  ]
}
