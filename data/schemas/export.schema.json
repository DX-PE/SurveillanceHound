{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "channel",
    "confidence",
    "firmware_version",
    "first_seen_ms",
    "hardware",
    "identifier",
    "last_seen_ms",
    "latitude",
    "location_source",
    "longitude",
    "observed_at",
    "privacy_mode",
    "radio",
    "region",
    "rssi_max",
    "rssi_min",
    "rule_ids",
    "schema_version",
    "score",
    "seen_count",
    "session_id",
    "signature_pack",
    "source_privacy_mode",
    "time_quality"
  ],
  "properties": {
    "latitude": {
      "type": "null"
    },
    "location_source": {
      "const": "none"
    },
    "hardware": {
      "const": "E32R40T"
    },
    "first_seen_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature_pack": {
      "type": "string",
      "pattern": "^v[0-9]+-[a-f0-9]{12}$"
    },
    "channel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 14
    },
    "last_seen_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "schema_version": {
      "const": 1
    },
    "privacy_mode": {
      "const": "sanitized"
    },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]{1,63}$"
      }
    },
    "seen_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "longitude": {
      "type": "null"
    },
    "category": {
      "enum": [
        "FLOCK",
        "AXON",
        "GLASSES",
        "SKIMMER",
        "RAVEN",
        "AIRTAG",
        "TILE",
        "SAMSUNG_TAG",
        "GOOGLE_TAG",
        "DRONE",
        "ALPR",
        "CAMERA",
        "RING",
        "IBEACON",
        "FLIPPER",
        "PWNAGOTCHI",
        "PINEAPPLE",
        "DEAUTH",
        "EVIL_TWIN"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "source_privacy_mode": {
      "enum": [
        "private",
        "research"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z2-7]{20}$"
    },
    "region": {
      "enum": [
        "US",
        "EU",
        "unknown"
      ]
    },
    "firmware_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
    },
    "radio": {
      "enum": [
        "wifi",
        "ble"
      ]
    },
    "rssi_min": {
      "type": "integer",
      "minimum": -127,
      "maximum": 20
    },
    "rssi_max": {
      "type": "integer",
      "minimum": -127,
      "maximum": 20
    },
    "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "time_quality": {
      "enum": [
        "uptime_only",
        "manual"
      ]
    }
  }
}
